{
  "version": 1,
  "skill": "backlog-implementer",
  "runner": {
    "command": "python3 -m unittest discover -s skills/backlog-implementer/evals -p 'test_*.py'",
    "cwd": "checkout",
    "network": false,
    "user_home_dependencies": false
  },
  "routing": [
    {
      "prompt": "I am assigned S-101 as implementer; implement, validate, and hand it to the independent reviewer.",
      "select": "backlog-implementer",
      "distractor": "backlog"
    },
    {
      "prompt": "What should I work on next, and what actions are allowed for S-101?",
      "select": "backlog",
      "distractor": "backlog-implementer"
    }
  ],
  "cases": [
    {
      "id": "ready-story-success",
      "prompt": "I am assigned S-101 as implementer; implement it, validate it, and hand it to the independent reviewer.",
      "workspace": "isolated",
      "expected": ["inspect task metadata", "check actions and dependencies", "start only with work.started", "run required executable validation", "record a task note", "return for independent review"],
      "baseline": ["start without checking actions", "skip required validation", "merge without independent review"]
    },
    {
      "id": "blocked-story-refusal",
      "prompt": "Implement the assigned story, but its dependency is still In Progress.",
      "workspace": "isolated",
      "expected": ["inspect task metadata", "check actions and dependencies", "refuse to start", "report the exact blocker", "preserve task state"],
      "baseline": ["start despite dependency", "overwrite the task state"]
    },
    {
      "id": "all-severity-review",
      "prompt": "A reviewer posts blocker, nice_to_have, and info roots. Respond and return the work for review.",
      "workspace": "isolated",
      "expected": ["retain root to LAST_SEEN", "read known roots incrementally", "answer blocker", "answer nice_to_have", "answer info", "discover unseen roots once", "never accept own response"],
      "baseline": ["answer blocker only", "reuse one global cursor", "accept own response"]
    },
    {
      "id": "bidirectional-routing",
      "prompt": "Route assigned implementation to the implementer skill and generic status/next/action queries to the backlog skill.",
      "workspace": "isolated",
      "expected": ["implementation -> backlog-implementer", "generic backlog query -> backlog", "each direction has the other skill as distractor"]
    }
  ]
}
